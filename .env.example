# Copia este archivo como .env y cambia los valores:  cp .env.example .env
# La contraseña de SQL Server debe tener 8+ caracteres con mayúscula, minúscula y número.
# Evita el símbolo "$" (Docker Compose lo interpreta como variable).
MSSQL_SA_PASSWORD=CambiaEstaClave123

# Conexión de la API a SQL Server (se leen como variables de entorno)
DB_HOST=db
DB_USER=sa
DB_NAME=OrdenesDB

# URL de la API que usa el frontend Django (nombre del servicio, no localhost)
API_URL=http://api:5000

# Tu usuario de Docker Hub (para nombrar las imágenes propias)
DOCKERHUB_USER=tu_usuario_dockerhub
